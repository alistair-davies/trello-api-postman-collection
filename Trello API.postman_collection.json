    {
      "name": "Delete Board",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "console.log(\"DELETE TESTS RUNNING\");",
              "",
              "// DELETE test — only run on DELETE response",
              "pm.test(\"Status code is 200\", () => {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "// GET verification — isolate it so Postman does NOT re-run DELETE test",
              "pm.test(\"Board is actually deleted\", () => {",
              "",
              "    pm.sendRequest({",
              "        url: `https://api.trello.com/1/boards/${pm.collectionVariables.get(\"boardId\")}`,",
              "        method: 'GET',",
              "        header: { \"Accept\": \"application/json\" },",
              "        params: {",
              "            key: pm.collectionVariables.get(\"trellokey\"),",
              "            token: pm.collectionVariables.get(\"trellotoken\")",
              "        }",
              "    }, (err, res) => {",
              "        // 🛑 Guard: if Postman re-runs tests and res is missing, stop",
              "        if (!res) return;",
              "",
              "        pm.expect(err).to.be.null;",
              "        pm.expect(res.status).to.eql(404);",
              "",
              "        const body = res.text();",
              "        pm.expect(body).to.include(\"not found\");",
              "    });",
              "});  ",
              ""
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        },
