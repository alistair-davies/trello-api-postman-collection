    {
      "name": "Create a board",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "//Ensure the API returned a successful status",
              "pm.test(\"Status code is 200\", () => {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "let response;",
              "",
              "//Test: confirm the board name returned by Trello matches the one sent",
              "pm.test(\"Board is created\", () => {",
              "    //Parse the JSON response body",
              "    response = pm.response.json();",
              "    pm.expect(response.name).to.eql('Learning Postman ' + pm.collectionVariables.get(\"boardNumber\"));",
              "});",
              "",
              "//Store the new boards ID for use in later requests",
              "pm.collectionVariables.set(\"boardId\", response.id);",
              "",
              "//Test to see that the board is set to open",
              "pm.test(\"Board is set to open\", () => {",
              "    pm.expect(response.closed).to.eql(false);",
              "});",
              "",
              "//Test to see the board is set to private",
              "pm.test(\"Board is set to private\", () => {",
              "    pm.expect(response.prefs.permissionLevel).to.eql('private');",
              "});",
              "",
              "//Test to see that calendar is disabled",
              "pm.test(\"Calendar is disabled\", () => {",
              "    const calendarView = response.prefs.switcherViews.find(view => view.viewType === 'Calendar');",
              "    pm.expect(calendarView).to.be.an('object');",
              "    pm.expect(calendarView.enabled).to.be.false;",
              "});",
              "",
              "",
              ""
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        },
        {
          "listen": "prerequest",
          "script": {
            "exec": [
              "let boardNumber = pm.collectionVariables.get('boardNumber');",
              "if (isNaN(boardNumber)){",
              "boardNumber =0; ",
              "",
              "};",
              "",
              "boardNumber++;",
              "pm.collectionVariables.set('boardNumber', boardNumber);"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
